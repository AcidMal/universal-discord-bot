# GHCR_USERNAME=acidmal
# GHCR_TOKEN=
# Set DATABASE_URL only to use a Postgres you already run. Otherwise the script
# starts Postgres 18.1 in the cluster and keeps the generated password here.
# DATABASE_URL=postgresql+asyncpg://bot:secret@postgres.example.com:5432/bot?ssl=require
# Managed databases drop traffic until each node public IP is allowed.
