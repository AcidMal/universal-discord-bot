# Async SQLAlchemy URL (asyncpg). Inside Compose, host is `postgres`.
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot

# Gateway bot token. Leave empty to keep the bot process idle.
DISCORD_TOKEN=

# Dashboard OAuth (Identify + guilds). Unused until the dashboard phase.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public origin of the web UI. Discord OAuth redirect is {PUBLIC_URL}/auth/callback.
PUBLIC_URL=http://localhost:5173

# Signs the dashboard session cookie. deploy.sh fills this in.
SESSION_SECRET=

# Optional stable id for this gateway replica. Leave empty so each process generates one.
NODE_ID=

# Optional override. 0 asks Discord for the recommended shard count.
SHARD_COUNT=0

# Discord user IDs allowed to edit global bot status. Comma-separated.
BOT_ADMIN_IDS=

# Twitch app credentials (developer.twitch.tv). Required for live alerts.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Verifies Twitch EventSub pushes. deploy.sh fills this in.
# Instant alerts also need PUBLIC_URL to be a public https origin that forwards /twitch to the API.
TWITCH_EVENTSUB_SECRET=
